<%- include('../partials/header') %>

<%- include('../partials/navbar') %>

<script>
  window.driveContext = {
    tab: 'storage',
    currentFolderId: ''
  };
</script>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 flex flex-col min-w-0 bg-[#F8F9FA] overflow-y-auto">
    <div class="p-6 md:p-8 w-full">
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-5 border-b border-gray-200 pb-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <i class="bi bi-pie-chart-fill text-brand-teal"></i>
                Storage
              </h2>
              <p class="text-sm text-gray-500 mt-1">Review what is using space in Harbor Drive.</p>
            </div>

            <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-teal hover:text-brand-teal-dark transition self-start sm:self-auto">
              <i class="bi bi-arrow-left"></i>
              My Drive
            </a>
          </div>

          <form method="GET" action="/storage" class="relative z-20 flex flex-wrap items-center gap-3">
            <input type="hidden" name="type" id="storage-type-input" value="<%= typeFilter || 'all' %>">
            <input type="hidden" name="modified" id="storage-modified-input" value="<%= modifiedFilter || 'all' %>">
            <input type="hidden" name="source" id="storage-source-input" value="<%= sourceFilter || 'all' %>">
            <input type="hidden" name="sortBy" value="<%= sortBy || 'size' %>">
            <input type="hidden" name="sortOrder" value="<%= sortOrder || 'desc' %>">

            <% 
              const storageTypeOptions = [
                { val: 'all', label: 'All', icon: 'bi-grid-fill' },
                { val: 'videos', label: 'Videos', icon: 'bi-film' },
                { val: 'images', label: 'Images', icon: 'bi-image' },
                { val: 'documents', label: 'Documents', icon: 'bi-file-earmark-text' },
                { val: 'spreadsheets', label: 'Spreadsheets', icon: 'bi-file-spreadsheet' },
                { val: 'audio', label: 'Audio', icon: 'bi-music-note-beamed' },
                { val: 'archives', label: 'Archives', icon: 'bi-file-zip' },
                { val: 'code', label: 'Code', icon: 'bi-code-slash' },
                { val: 'other', label: 'Other', icon: 'bi-file-earmark' }
              ];
              const storageModifiedOptions = [
                { val: 'all', label: 'Any time', icon: 'bi-calendar3' },
                { val: 'today', label: 'Today', icon: 'bi-calendar-event' },
                { val: 'week', label: 'Last 7 days', icon: 'bi-calendar-week' },
                { val: 'month', label: 'Last 30 days', icon: 'bi-calendar-month' },
                { val: 'year', label: 'Last year', icon: 'bi-calendar-range' }
              ];
              const storageSourceOptions = [
                { val: 'all', label: 'All', icon: 'bi-collection' },
                { val: 'private', label: 'Private', icon: 'bi-lock' },
                { val: 'public', label: 'Public', icon: 'bi-globe' }
              ];
              const selectedType = storageTypeOptions.find(o => o.val === (typeFilter || 'all')) || storageTypeOptions[0];
              const selectedModified = storageModifiedOptions.find(o => o.val === (modifiedFilter || 'all')) || storageModifiedOptions[0];
              const selectedSource = storageSourceOptions.find(o => o.val === (sourceFilter || 'all')) || storageSourceOptions[0];
            %>

            <div class="relative" id="storage-type-dropdown">
              <button type="button" class="dropdown-trigger inline-flex items-center gap-2 border border-gray-300 bg-white hover:bg-gray-50 rounded-lg px-3 py-2 text-sm font-semibold text-gray-700 transition cursor-pointer select-none">
                <span class="text-gray-500">Type</span>
                <span class="selected-text flex items-center gap-1.5">
                  <i class="bi <%= selectedType.icon %> text-gray-400"></i>
                  <%= selectedType.label %>
                </span>
                <i class="bi bi-chevron-down text-[10px] text-gray-400"></i>
              </button>
              <div class="dropdown-menu absolute left-0 mt-2 w-48 bg-white border border-gray-200 rounded-xl shadow-lg p-1 hidden z-50 animate-in fade-in-50 slide-in-from-top-1 duration-100">
                <% storageTypeOptions.forEach(item => { %>
                  <button type="button" data-value="<%= item.val %>" class="dropdown-item w-full text-left px-3 py-2 text-xs font-semibold rounded-lg flex items-center justify-between transition gap-2 <%= (typeFilter || 'all') === item.val ? 'bg-brand-teal/5 text-brand-teal' : 'text-gray-700 hover:bg-gray-100 hover:text-brand-teal' %>">
                    <span class="flex items-center gap-2">
                      <i class="bi <%= item.icon %> <%= (typeFilter || 'all') === item.val ? 'text-brand-teal' : 'text-gray-400' %> text-sm"></i>
                      <%= item.label %>
                    </span>
                    <% if ((typeFilter || 'all') === item.val) { %>
                      <i class="bi bi-check-lg text-brand-teal text-sm"></i>
                    <% } %>
                  </button>
                <% }) %>
              </div>
            </div>

            <div class="relative" id="storage-modified-dropdown">
              <button type="button" class="dropdown-trigger inline-flex items-center gap-2 border border-gray-300 bg-white hover:bg-gray-50 rounded-lg px-3 py-2 text-sm font-semibold text-gray-700 transition cursor-pointer select-none">
                <span class="text-gray-500">Modified</span>
                <span class="selected-text flex items-center gap-1.5">
                  <i class="bi <%= selectedModified.icon %> text-gray-400"></i>
                  <%= selectedModified.label %>
                </span>
                <i class="bi bi-chevron-down text-[10px] text-gray-400"></i>
              </button>
              <div class="dropdown-menu absolute left-0 mt-2 w-48 bg-white border border-gray-200 rounded-xl shadow-lg p-1 hidden z-50 animate-in fade-in-50 slide-in-from-top-1 duration-100">
                <% storageModifiedOptions.forEach(item => { %>
                  <button type="button" data-value="<%= item.val %>" class="dropdown-item w-full text-left px-3 py-2 text-xs font-semibold rounded-lg flex items-center justify-between transition gap-2 <%= (modifiedFilter || 'all') === item.val ? 'bg-brand-teal/5 text-brand-teal' : 'text-gray-700 hover:bg-gray-100 hover:text-brand-teal' %>">
                    <span class="flex items-center gap-2">
                      <i class="bi <%= item.icon %> <%= (modifiedFilter || 'all') === item.val ? 'text-brand-teal' : 'text-gray-400' %> text-sm"></i>
                      <%= item.label %>
                    </span>
                    <% if ((modifiedFilter || 'all') === item.val) { %>
                      <i class="bi bi-check-lg text-brand-teal text-sm"></i>
                    <% } %>
                  </button>
                <% }) %>
              </div>
            </div>

            <div class="relative" id="storage-source-dropdown">
              <button type="button" class="dropdown-trigger inline-flex items-center gap-2 border border-gray-300 bg-white hover:bg-gray-50 rounded-lg px-3 py-2 text-sm font-semibold text-gray-700 transition cursor-pointer select-none">
                <span class="text-gray-500">Source</span>
                <span class="selected-text flex items-center gap-1.5">
                  <i class="bi <%= selectedSource.icon %> text-gray-400"></i>
                  <%= selectedSource.label %>
                </span>
                <i class="bi bi-chevron-down text-[10px] text-gray-400"></i>
              </button>
              <div class="dropdown-menu absolute left-0 mt-2 w-44 bg-white border border-gray-200 rounded-xl shadow-lg p-1 hidden z-50 animate-in fade-in-50 slide-in-from-top-1 duration-100">
                <% storageSourceOptions.forEach(item => { %>
                  <button type="button" data-value="<%= item.val %>" class="dropdown-item w-full text-left px-3 py-2 text-xs font-semibold rounded-lg flex items-center justify-between transition gap-2 <%= (sourceFilter || 'all') === item.val ? 'bg-brand-teal/5 text-brand-teal' : 'text-gray-700 hover:bg-gray-100 hover:text-brand-teal' %>">
                    <span class="flex items-center gap-2">
                      <i class="bi <%= item.icon %> <%= (sourceFilter || 'all') === item.val ? 'text-brand-teal' : 'text-gray-400' %> text-sm"></i>
                      <%= item.label %>
                    </span>
                    <% if ((sourceFilter || 'all') === item.val) { %>
                      <i class="bi bi-check-lg text-brand-teal text-sm"></i>
                    <% } %>
                  </button>
                <% }) %>
              </div>
            </div>
          </form>

          <div class="flex flex-col gap-3">
            <div class="flex flex-wrap items-end gap-x-2 gap-y-1">
              <span class="text-4xl font-medium leading-none text-gray-900"><%= formatBytes(storageStats.totalSize) %></span>
              <span class="text-sm text-gray-500 pb-1">used across <%= storageStats.totalFiles || 0 %> files</span>
            </div>

            <div class="h-2 w-full rounded-full bg-gray-100 overflow-hidden flex" aria-label="Storage usage by type">
              <% if (categoryTotals.length > 0) { %>
                <% categoryTotals.forEach(category => { %>
                  <span
                    class="h-full"
                    title="<%= category.name %>: <%= formatBytes(category.size) %>"
                    style="width: <%= Math.max(category.percent, 0.75).toFixed(2) %>%; background-color: <%= category.color %>;"
                  ></span>
                <% }) %>
              <% } %>
            </div>

            <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-700">
              <% categoryTotals.forEach(category => { %>
                <span class="inline-flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full" style="background-color: <%= category.color %>;"></span>
                  <span><%= category.name %></span>
                </span>
              <% }) %>
            </div>
          </div>
        </div>

        <%
          const activeSortBy = sortBy || 'size';
          const activeSortOrder = sortOrder || 'desc';
          const storageQueryBase = `type=${encodeURIComponent(typeFilter || 'all')}&modified=${encodeURIComponent(modifiedFilter || 'all')}&source=${encodeURIComponent(sourceFilter || 'all')}`;
          const modifiedSortOrder = activeSortBy === 'modified' && activeSortOrder === 'desc' ? 'asc' : 'desc';
          const sizeSortOrder = activeSortBy === 'size' && activeSortOrder === 'desc' ? 'asc' : 'desc';
        %>
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div class="grid grid-cols-12 gap-3 px-4 py-3 border-b border-gray-200 text-sm font-semibold text-gray-600">
            <div class="col-span-7 md:col-span-6">Name</div>
            <div class="hidden md:block md:col-span-2">Type</div>
            <div class="hidden sm:block sm:col-span-2">
              <a
                href="/storage?<%= storageQueryBase %>&sortBy=modified&sortOrder=<%= modifiedSortOrder %>"
                class="inline-flex items-center gap-2 hover:text-brand-teal transition <%= activeSortBy === 'modified' ? 'text-gray-800' : 'text-gray-600' %>"
                title="Sort by modified <%= activeSortBy === 'modified' && activeSortOrder === 'desc' ? 'ascending' : 'descending' %>"
                aria-label="Sort by modified <%= activeSortBy === 'modified' && activeSortOrder === 'desc' ? 'ascending' : 'descending' %>"
              >
                Modified
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full <%= activeSortBy === 'modified' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-500' %>">
                  <i class="bi <%= activeSortBy === 'modified' ? (activeSortOrder === 'asc' ? 'bi-arrow-up' : 'bi-arrow-down') : 'bi-arrow-down-up' %> text-base"></i>
                </span>
              </a>
            </div>
            <div class="col-span-5 sm:col-span-3 md:col-span-2 text-right">
              <a
                href="/storage?<%= storageQueryBase %>&sortBy=size&sortOrder=<%= sizeSortOrder %>"
                class="inline-flex items-center justify-end gap-2 hover:text-brand-teal transition <%= activeSortBy === 'size' ? 'text-gray-800' : 'text-gray-600' %>"
                title="Sort by storage used <%= activeSortBy === 'size' && activeSortOrder === 'desc' ? 'ascending' : 'descending' %>"
                aria-label="Sort by storage used <%= activeSortBy === 'size' && activeSortOrder === 'desc' ? 'ascending' : 'descending' %>"
              >
                Storage used
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full <%= activeSortBy === 'size' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-500' %>">
                  <i class="bi <%= activeSortBy === 'size' ? (activeSortOrder === 'asc' ? 'bi-arrow-up' : 'bi-arrow-down') : 'bi-arrow-down-up' %> text-base"></i>
                </span>
              </a>
            </div>
          </div>

          <% if (files.length === 0) { %>
            <div class="px-4 py-16 text-center">
              <div class="mx-auto mb-4 h-14 w-14 rounded-xl bg-gray-100 text-gray-400 flex items-center justify-center">
                <i class="bi bi-hdd text-2xl"></i>
              </div>
              <h3 class="text-base font-bold text-gray-800">No files match these filters</h3>
              <p class="text-sm text-gray-500 mt-1">Change the filters or upload files to see storage usage.</p>
            </div>
          <% } else { %>
            <div class="divide-y divide-gray-200">
              <% files.forEach((file, index) => { %>
                <a
                  href="/preview/<%= file.previewRoute %>/<%= file.id %>"
                  class="grid grid-cols-12 gap-3 px-4 py-4 items-center hover:bg-gray-50 transition text-gray-800 <%= index === 0 ? 'bg-gray-50' : '' %>"
                >
                  <div class="col-span-7 md:col-span-6 min-w-0 flex items-center gap-3">
                    <span class="h-9 w-9 rounded-lg bg-gray-100 flex items-center justify-center shrink-0" style="color: <%= file.categoryColor %>;">
                      <i class="bi <%= file.categoryIcon %> text-lg"></i>
                    </span>
                    <div class="min-w-0">
                      <div class="font-semibold text-sm truncate"><%= file.originalName %></div>
                      <div class="md:hidden text-xs text-gray-500 mt-0.5"><%= file.category %> in <%= file.folderName %></div>
                    </div>
                  </div>
                  <div class="hidden md:block md:col-span-2 text-sm text-gray-600 truncate"><%= file.category %></div>
                  <div class="hidden sm:block sm:col-span-2 text-sm text-gray-600"><%= new Date(file.createdAt).toLocaleDateString() %></div>
                  <div class="col-span-5 sm:col-span-3 md:col-span-2 text-right text-sm font-semibold text-gray-700"><%= formatBytes(file.size) %></div>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/modals') %>

<%- include('../partials/footer') %>
